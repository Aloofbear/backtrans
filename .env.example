# Server-only. Never expose this value in a VITE_ variable or commit a real key.
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"
DEEPSEEK_API_URL="https://api.deepseek.com/chat/completions"

# Vercel API proxy. Use disabled to force Vercel to call DeepSeek directly.
MAINLAND_API_BASE_URL="http://8.163.84.238:8787"

# Frontend. Leave empty when the API is served from the same origin.
# For local split dev, use: VITE_API_BASE_URL="http://localhost:8787"
VITE_API_BASE_URL=""

# Optional frontend failover list. Put a mainland-accessible API first, then Vercel as backup.
# Example: VITE_API_BASE_URLS="https://api.your-domain.cn,https://github-backtrans.vercel.app"
VITE_API_BASE_URLS=""

# Optional analytics. Leave empty to disable Google Analytics.
VITE_GA_MEASUREMENT_ID=""

# Self-hosted product analytics. ECS stores events in ANALYTICS_DIR/events.jsonl.
ANALYTICS_DIR="./data"
ANALYTICS_SALT=""
ANALYTICS_ADMIN_TOKEN=""

# Frontend analytics endpoint. HTTPS pages should use the Vercel proxy, which forwards to ECS.
VITE_ANALYTICS_API_BASE_URL=""
VITE_ANALYTICS_API_BASE_URLS=""

# Optional CORS allow origin for the API server.
APP_ORIGIN="http://localhost:3000"
